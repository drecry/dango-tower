# Production build settings (read by `npm run build`).
#
# ★This file IS committed★ — Cloudflare builds from GitHub, so the
# values must live here (.env is gitignored). Nothing secret goes in
# this file: everything in it is baked into the build where anyone
# can see it. The URL below is a public API address (visible in
# network traffic anyway), exactly as in Dango Drop's setup.
#
# ★When the ranking API URL changes, the API side must allow this
# game's origin★ — dango-leaderboard/worker/wrangler.toml
# ALLOWED_ORIGINS. https://drecry.com is already on the list.

# Ranking API address (shared family leaderboard, game_id=dango-tower)
VITE_LEADERBOARD_URL=https://dango-leaderboard.t-drecry.workers.dev

# Ranking on/off. Platforms that block external requests (Poki)
# need a build with this set to false.
VITE_RANKING_ENABLED=true
