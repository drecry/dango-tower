# Dango Tower — environment variables (template)
# Copy to .env for local overrides. Production values live in
# .env.production (committed, no secrets — see that file's notes).
# With nothing set, the game still plays fully; only the online
# ranking is off and bests stay in localStorage.

# Ranking API base URL (shared family leaderboard).
VITE_LEADERBOARD_URL=

# Ranking on/off (platforms that block external requests need false).
VITE_RANKING_ENABLED=true
